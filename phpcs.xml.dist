<?xml version="1.0"?>
<ruleset name="Oraculo Tainacan">
    <description>Coding standards do plugin Oráculo Tainacan (WordPress-Core/Docs/Extra + Security + PHPCompatibilityWP).</description>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress.Security"/>

    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP"/>

    <config name="minimum_wp_version" value="6.0"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="oraculo-tainacan"/>
            </property>
        </properties>
    </rule>

    <arg name="extensions" value="php"/>
    <!-- Mostrar o código do sniff em cada finding -->
    <arg value="s"/>

    <file>.</file>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/vendor/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
</ruleset>
