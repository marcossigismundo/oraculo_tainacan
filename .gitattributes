# O repositório é normalizado em LF. Sem isto, checkouts em Windows podem
# reintroduzir CRLF e produzir diffs de arquivo inteiro em cada merge.
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.dist  text eol=lf

# Binários
*.png   binary
*.jpg   binary
*.gif   binary
*.woff  binary
*.woff2 binary

# Não empacotar tooling de desenvolvimento em exports/tarballs
/.gitattributes   export-ignore
/.gitignore       export-ignore
/composer.json    export-ignore
/composer.lock    export-ignore
/phpcs.xml.dist   export-ignore
/docs/            export-ignore
